// PostgreSQL is the application database; its URL lives in prisma.config.ts.
datasource db {
  provider = "postgresql"
}

/// The current processing step for an uploaded JSON batch.
enum BatchStatus {
  READY /// Validation and deduplication finished; the retained jobs can be reviewed.
  NORMALIZING /// Model preprocessing is currently running.
  NORMALIZED /// Versioned model-ready rows exist for every retained job.
  RANK_PENDING /// A ranking request exists but no model worker has executed it.
  RANKING /// A model worker currently owns the ranking run.
  RANKED /// Real model results were stored successfully.
  FAILED /// The latest processing attempt failed and may be retried.
}

/// The explicit preference label supplied by the user.
enum RelevanceLabel {
  DREAM /// An exceptional role that should be reviewed first.
  STRONG_APPLY /// A strong match that is worth applying to.
  CONSIDER /// Potentially useful, but not an immediate priority.
  REJECT /// Not relevant; also supplies a negative learning signal.
}

/// Tracks personal review progress independently of application progress.
enum ReviewStatus {
  NEW /// The job has not been opened yet.
  VIEWED /// The job has been inspected.
  SAVED /// The job was intentionally kept for later.
  DISMISSED /// The job was hidden from the active review list.
}

/// Tracks the real application funnel for a job.
enum ApplicationStatus {
  NOT_STARTED /// No application work has begun.
  PREPARING /// Resume, answers, or supporting material are being prepared.
  APPLIED /// An application was submitted.
  SCREENING /// Recruiter or employer screening is in progress.
  ASSESSMENT /// A test, task, or screening assessment is in progress.
  INTERVIEW /// At least one interview stage has been reached.
  OFFER /// An offer was received.
  ACCEPTED /// An offer was accepted and the application is complete.
  REJECTED /// The employer rejected the application.
  WITHDRAWN /// The application was deliberately stopped.
}

/// The kind of company-specific step recorded inside an application.
enum ApplicationMilestoneType {
  SCREENING /// Recruiter call, eligibility check, or other screening step.
  ASSESSMENT /// Coding test, take-home task, or aptitude assessment.
  INTERVIEW /// Any interview round; the title carries the round name.
  FOLLOW_UP /// A reminder to follow up with the company or recruiter.
  OTHER /// A useful step that does not fit the fixed milestone types.
}

/// The user-controlled lifecycle of one application milestone.
enum ApplicationMilestoneStatus {
  PLANNED /// The milestone is expected but has not been completed.
  COMPLETED /// The milestone happened or its action was finished.
  CANCELLED /// The milestone was intentionally cancelled but remains in history.
}

/// The lifecycle of a retryable background processing attempt.
enum ProcessingStatus {
  QUEUED /// The run is waiting for a worker.
  RUNNING /// A worker currently owns the run.
  SUCCEEDED /// The requested step completed successfully.
  FAILED /// The run stopped and recorded an error.
}

/// The delivery state of an email digest.
enum EmailStatus {
  UNTOUCHED /// The personalized mail event is waiting for its first claim.
  SENDING /// One sender owns a short delivery lease.
  SENT /// The email provider accepted the message.
  FAILED /// The current delivery attempts failed.
  BLOCKED /// The event exists but cannot send until its member setup is repaired.
  CANCELLED /// The recipient was disabled before this queued delivery was sent.
}

/// The aggregate lifecycle of one dated newsletter campaign.
enum EmailCampaignStatus {
  WAITING_FOR_RANKINGS /// The date exists, but no eligible successful ranking run exists yet.
  PENDING /// The top-ten snapshot exists and recipient deliveries can be claimed.
  SENDING /// At least one recipient delivery currently owns a sender lease.
  SENT /// Every non-cancelled recipient delivery was accepted by the provider.
  PARTIAL_FAILED /// Some recipients succeeded while others exhausted the current retry cycle.
  FAILED /// No recipient delivery completed successfully.
  SKIPPED /// Sending was disabled or the date had no eligible recipients or rankings.
  EXPIRED /// An unsent campaign became stale and requires explicit owner action.
}

/// The single private account allowed to access JEDI.
model User {
  id           String       @id @default(cuid()) /// Internal identifier stored inside the signed login session.
  email        String       @unique /// Lowercase email entered on the login page.
  passwordHash String /// Argon2 password hash compared during login; plaintext is never stored.
  ownedGroup   Group? /// The one shared JEDI group this user administers, when they are its owner.
  membership   GroupMember? /// The user's single group membership in v1.
  createdAt    DateTime     @default(now()) /// Records when the private account was created.
  updatedAt    DateTime     @updatedAt /// Records the latest account or password change.
}

/// The shared v1 workspace whose members use one ranking profile and model.
model Group {
  id                     String            @id @default(cuid()) /// Internal identifier returned with authenticated sessions.
  name                   String            @default("JEDI") /// Friendly group name shown during onboarding and in settings.
  ownerId                String            @unique /// Identifies the user allowed to create and revoke invitations.
  owner                  User              @relation(fields: [ownerId], references: [id], onDelete: Restrict) /// Loads the group administrator without adding a role to User.
  activeProfileVersionId String? /// Pins the shared profile used for every member's v1 ranking.
  activeProfileVersion   ProfileVersion?   @relation("GroupActiveProfile", fields: [activeProfileVersionId], references: [id], onDelete: SetNull) /// Loads the shared ranking profile when configured.
  activeModelVersionId   String? /// Pins the shared model used for every member's v1 ranking.
  activeModelVersion     ModelVersion?     @relation("GroupActiveModel", fields: [activeModelVersionId], references: [id], onDelete: SetNull) /// Loads the shared ranking model when configured.
  members                GroupMember[] /// Users who can access the shared workspace.
  invitations            GroupInvitation[] /// Reusable short codes that can admit new members.
  createdAt              DateTime          @default(now()) /// Records when the shared workspace was created.
  updatedAt              DateTime          @updatedAt /// Records profile, model, name, or owner changes.

  @@index([activeProfileVersionId])
  @@index([activeModelVersionId])
}

/// Connects one user to the single shared JEDI group.
model GroupMember {
  id                    String                 @id @default(cuid()) /// Internal membership identifier used by onboarding.
  groupId               String /// Identifies the shared workspace the member joined.
  group                 Group                  @relation(fields: [groupId], references: [id], onDelete: Cascade) /// Loads shared profile, model, and members.
  userId                String                 @unique /// Enforces one group membership per user in v1.
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade) /// Loads login credentials and email from the unchanged User record.
  onboardingCompletedAt DateTime? /// A null value forces the member through profile onboarding.
  joinedAt              DateTime               @default(now()) /// Records when registration joined the group.
  resumeEvidence        ResumeEvidence?
  learningAttempts      LearningAttempt[]
  memberProfile         MemberProfile? /// Stores the member's future-personalization profile.
  emailRecipient        EmailRecipient? /// Links this member to the only personalized newsletter destination allowed in v1.
  emailDeliveries       EmailDelivery[] /// Personalized mail events owned by this member.
  emailDeliveryAttempts EmailDeliveryAttempt[] @relation("EmailDeliveryAttemptActor") /// Manual delivery actions requested by this member.
  jobStates             JobState[] /// Private review state for shared jobs.
  applications          Application[] /// Private application records for shared jobs.
  annotations           JobAnnotation[] /// Private labels saved by this member.
  trainingExamples      TrainingExample[] /// Training rows whose labels came from this member.

  @@unique([groupId, userId])
  @@index([groupId, joinedAt])
}

/// A reusable five-character code that admits users into one group.
model GroupInvitation {
  id         String    @id @default(cuid()) /// Internal identifier used to revoke an invitation.
  groupId    String /// Identifies the group joined by successful registrations.
  group      Group     @relation(fields: [groupId], references: [id], onDelete: Cascade) /// Loads the group and its member limit.
  codeHash   String    @unique /// Stores only the keyed hash of the uppercase invitation code.
  expiresAt  DateTime /// Stops the reusable code seven days after creation.
  revokedAt  DateTime? /// Immediately disables the code when the owner revokes or replaces it.
  usageCount Int       @default(0) /// Counts successful registrations without recording the raw code.
  createdAt  DateTime  @default(now()) /// Records when the owner generated the code.

  @@index([groupId, revokedAt, expiresAt])
}

/// Profile collected from a member for future personalized ranking in v2.
model MemberProfile {
  id                 String      @id @default(cuid()) /// Internal identifier for the member-owned onboarding profile.
  groupMemberId      String      @unique /// Enforces one editable onboarding profile per member.
  groupMember        GroupMember @relation(fields: [groupMemberId], references: [id], onDelete: Cascade) /// Loads the member whose future preferences these are.
  contentHash        String /// Detects an unchanged onboarding replay for this member.
  resumeText         String /// Full profile or resume content saved for future personalization.
  preferredTitles    String[] /// Normalized desired job-title tags.
  preferredLocations String[] /// Normalized desired location tags.
  preferredSkills    String[] /// Normalized desired skill tags.
  experienceMinYears Float? /// Lower bound of the member's desired experience range.
  experienceMaxYears Float? /// Upper bound of the member's desired experience range.
  salaryMin          Decimal?    @db.Decimal(14, 2) /// Lowest useful annual compensation.
  salaryMax          Decimal?    @db.Decimal(14, 2) /// Highest useful annual compensation.
  salaryCurrency     String? /// Currency required to interpret the compensation range.
  createdAt          DateTime    @default(now()) /// Records initial onboarding submission.
  updatedAt          DateTime    @updatedAt /// Records later onboarding-profile corrections.

  @@index([contentHash])
}

/// One uploaded JSON payload and its processing summary.
model Batch {
  id              String      @id @default(cuid()) /// Internal database identifier used by relations.
  displayName     String?     @unique /// Friendly generated label used in the interface while the external identifier remains immutable.
  externalBatchId String      @unique /// Identifier supplied in the uploaded JSON for safe repeated submissions.
  contentHash     String      @unique /// Prevents the exact same JSON payload from being imported twice.
  schemaVersion   String /// Identifies the JSON contract used by this payload.
  promptVersion   String? /// Identifies the discovery prompt that generated the jobs when available.
  generatedAt     DateTime /// Records when the discovery automation generated the JSON.
  rawEnvelope     Json /// Keeps the uploaded JSON intact so a failed batch can be inspected or retried.
  status          BatchStatus @default(READY) /// Drives action availability and dashboard filtering.

  receivedCount  Int @default(0) /// Number of job objects present in the uploaded JSON.
  validCount     Int @default(0) /// Number of job objects that passed validation.
  duplicateCount Int @default(0) /// Number of jobs automatically discarded as duplicates.
  jobCount       Int @default(0) /// Number of unique jobs retained after validation and deduplication.

  validationReport Json? /// Contains actionable validation errors for the batch when needed.

  jobs             Job[] /// Unique jobs retained from this upload; each job belongs to one batch.
  predictions      JobPrediction[] /// Ranking results produced for jobs in this batch.
  processingRuns   ProcessingRun[] /// Retry and failure records for batch processing.
  trainingExamples TrainingExample[] /// Training snapshots selected from this batch.
  emailDeliveries  EmailDelivery[] /// Legacy batch-specific deliveries retained during the campaign transition.

  createdAt DateTime  @default(now()) /// Records when the application accepted the upload.
  rankedAt  DateTime? /// Records when real ranking results were accepted.

  // Supports the dashboard and worker queries for recent batches by status.
  @@index([status, createdAt])
}

/// One unique job retained after automatic deduplication.
enum SalaryPeriod {
  YEARLY
  MONTHLY
}

model Job {
  id         String @id @default(cuid()) /// Internal database identifier.
  code       String @unique /// Short readable identifier used in URLs, emails, and the dashboard.
  dedupeKey  String @unique /// Deterministic normalized key used to reject an already-known job automatically.
  companyKey String /// Indexed normalized company name used to retrieve duplicate candidates cheaply.

  batchId String /// Identifies the upload that first introduced this unique job.
  batch   Batch  @relation(fields: [batchId], references: [id], onDelete: Cascade) /// Loads that owning batch.

  companyName String /// Company name shown to the user and used by duplicate rules.
  roleTitle   String /// Job title shown to the user and used by ranking.
  roleFamily  String? /// Broad model category such as frontend, data, or product when available.
  seniority   String? /// Normalized level such as intern, entry, mid, or senior when available.

  location       String? /// Location text supplied for display and ranking.
  workMode       String? /// Remote, hybrid, onsite, or another stated arrangement.
  employmentType String? /// Full-time, internship, contract, part-time, or another stated type.

  description String /// Full job description used for review, deduplication, and text features.
  skills      String[] /// Normalized skills or requirements used by search and ranking.

  experienceMinYears Float? /// Lowest stated experience requirement when the listing provides one.
  experienceMaxYears Float? /// Highest stated experience requirement when the listing provides one.

  salaryMin      Decimal?      @db.Decimal(14, 2) /// Lowest stated salary or stipend amount.
  salaryMax      Decimal?      @db.Decimal(14, 2) /// Highest stated salary or stipend amount.
  salaryCurrency String? /// Currency required to interpret the salary amounts.
  salaryPeriod   SalaryPeriod? /// Whether the stated compensation is annual or monthly.

  postedAt            DateTime? /// Publication time used as an optional recency feature.
  applicationDeadline DateTime? /// Stated last application date when the listing provides one.
  canApplyNow         Boolean? /// Imported eligibility hint used to suppress unusable recommendations.
  applyUrl            String /// Direct URL used when applying to the job.

  predictions      JobPrediction[] /// Prisma back-relation for ranking rows; this adds no field to the Job row.
  states           JobState[] /// Per-member relevance, review status, and review notes.
  applications     Application[] /// Per-member application plans for this shared job.
  annotations      JobAnnotation[] /// Per-member labels used for future personalization.
  preparedJobs     PreparedJob[] /// Versioned model-ready representations of this job.
  trainingExamples TrainingExample[] /// Model-training snapshots selected from this job.

  createdAt DateTime @default(now()) /// Records when the unique job was first stored.
  updatedAt DateTime @updatedAt /// Records the last edit to the job data or dedupe key.

  // Narrows automatic duplicate checks to jobs with the same company and title.
  @@index([companyKey])
  @@index([companyKey, roleTitle])
  @@index([batchId])
}

/// One version of the resume and the small set of preferences used for ranking.
model ProfileVersion {
  id          String @id @default(cuid()) /// Internal identifier referenced by ranking results.
  contentHash String @unique /// Prevents an unchanged resume and preference set from being stored twice.
  resumeText  String /// Resume content used by text and suitability features.

  preferredTitles    String[] /// Job titles or title keywords that should receive stronger matches.
  preferredLocations String[] /// Locations that should receive stronger matches.
  preferredSkills    String[] /// Skills and keywords used for resume-to-job matching.

  experienceMinYears Float? /// Lower end of the preferred experience range.
  experienceMaxYears Float? /// Upper end of the preferred experience range.
  salaryMin          Decimal? @db.Decimal(14, 2) /// Lowest preferred compensation.
  salaryMax          Decimal? @db.Decimal(14, 2) /// Highest useful compensation bound when one exists.
  salaryCurrency     String? /// Currency used by the preferred salary range.

  active           Boolean           @default(false) /// Marks the profile used for new ranking runs.
  predictions      JobPrediction[] /// Prisma back-relation for results produced with this profile.
  preparedJobs     PreparedJob[] /// Model-ready job rows built against this profile version.
  trainingExamples TrainingExample[] /// Training snapshots created against this exact profile.
  processingRuns   ProcessingRun[] /// Normalization and ranking attempts pinned to this profile.
  activeForGroups  Group[]           @relation("GroupActiveProfile") /// Groups currently using this profile for shared ranking.
  createdAt        DateTime          @default(now()) /// Orders profile versions and supports rollback.

  // Finds the profile currently used for scoring.
  @@index([active])
}

/// One versioned model-input row produced from a job and profile.
model PreparedJob {
  id                   String @id @default(cuid()) /// Internal identifier for this prepared row.
  featureSchemaVersion String /// Exact input contract used to build the payload.
  payloadHash          String /// Detects an unchanged transformation and makes retries idempotent.
  payload              Json /// Complete model-ready row consumed by future inference.

  jobId String /// Identifies the source job.
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade) /// Loads the source job.

  profileVersionId String /// Identifies the profile used for preference-relative fields.
  profileVersion   ProfileVersion @relation(fields: [profileVersionId], references: [id]) /// Loads that profile.

  createdAt DateTime @default(now()) /// Records when preprocessing produced this row.
  updatedAt DateTime @updatedAt /// Records when an idempotent retry refreshed the payload.

  // Keeps one current row per job, profile, and feature contract.
  @@unique([jobId, profileVersionId, featureSchemaVersion])
  @@index([profileVersionId, featureSchemaVersion])
}

/// Manual supervised labels for one retained job.
model JobAnnotation {
  groupMemberId String /// Identifies the member who supplied these private labels.
  groupMember   GroupMember @relation(fields: [groupMemberId], references: [id], onDelete: Cascade) /// Loads the label owner.
  jobId         String /// Identifies the shared job being annotated.
  job           Job         @relation(fields: [jobId], references: [id], onDelete: Cascade) /// Loads the annotated job.

  applyLabel        Boolean? /// Binary yes or no target used by the apply-preference classifier.
  roleTitleFit      Float? /// Manual 0-5 title fit score.
  roleFamilyFit     Float? /// Manual 0-5 role-family fit score.
  seniorityFit      Float? /// Manual 0-5 seniority fit score.
  locationFit       Float? /// Manual 0-5 location fit score.
  workModeFit       Float? /// Manual 0-5 work-mode fit score.
  experienceFit     Float? /// Manual 0-5 experience fit score.
  skillsFit         Float? /// Manual 0-5 skills fit score.
  salaryFit         Float? /// Manual 0-8 compensation fit score kept for model compatibility.
  overallPreference Float? /// Manual 0-5 overall preference score.

  createdAt DateTime @default(now()) /// Records when annotation began.
  updatedAt DateTime @updatedAt /// Records the most recent label edit.

  @@id([groupMemberId, jobId])
  @@index([jobId])
}

/// Canonical versioned row selected for model training.
model TrainingExample {
  id                   String @id @default(cuid()) /// Internal identifier for the training row.
  featureSchemaVersion String /// Feature contract required to interpret the stored input payload.
  payloadHash          String /// Detects the exact prepared payload frozen into this example.
  featurePayload       Json /// Frozen model-input values copied from PreparedJob.

  applyLabel        Boolean /// Binary supervised target.
  roleTitleFit      Float /// Frozen 0-5 title fit label.
  roleFamilyFit     Float /// Frozen 0-5 role-family fit label.
  seniorityFit      Float /// Frozen 0-5 seniority fit label.
  locationFit       Float /// Frozen 0-5 location fit label.
  workModeFit       Float /// Frozen 0-5 work-mode fit label.
  experienceFit     Float /// Frozen 0-5 experience fit label.
  skillsFit         Float /// Frozen 0-5 skills fit label.
  salaryFit         Float /// Frozen 0-8 compensation fit label.
  overallPreference Float /// Frozen 0-5 overall preference label.

  jobId String /// Identifies the annotated source job.
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Restrict) /// Keeps provenance to the job.

  batchId String /// Identifies the batch from which the row was selected.
  batch   Batch  @relation(fields: [batchId], references: [id], onDelete: Restrict) /// Keeps batch provenance.

  profileVersionId String /// Identifies the resume and preferences used to build the feature payload.
  profileVersion   ProfileVersion @relation(fields: [profileVersionId], references: [id], onDelete: Restrict) /// Preserves profile-specific training provenance.

  annotatedByGroupMemberId String /// Records which member supplied the frozen labels.
  annotatedByGroupMember   GroupMember @relation(fields: [annotatedByGroupMemberId], references: [id], onDelete: Restrict) /// Preserves ownership without making it a model feature.

  createdAt DateTime @default(now()) /// Records when the row first joined the master dataset.
  updatedAt DateTime @updatedAt /// Records when the same job/schema snapshot was refreshed.

  // Re-adding a job refreshes its current snapshot instead of duplicating it.
  @@unique([jobId, profileVersionId, featureSchemaVersion])
  @@index([batchId])
  @@index([annotatedByGroupMemberId])
}

/// One registered version of the complete ranking model bundle.
model ModelVersion {
  id                     String   @id @default(cuid()) /// Internal identifier stored with ranking results.
  name                   String   @unique /// Human-readable version such as ranking-2026-07.
  contentHash            String   @unique /// Makes immutable model metadata creation safely replayable.
  description            String   @default("") /// Human explanation shown on the model card.
  modelFamily            String   @default("legacy") /// Algorithm or bundle family such as stacked-ranking-model.
  artifactManifest       Json /// Artifact paths, checksums, libraries, and loading instructions.
  featureSchemaVersion   String /// Exact model-input contract expected by this bundle.
  requestContractVersion String   @default("jedi-ranking-v1") /// Version of the remote ranking HTTP contract.
  tags                   String[] @default([]) /// Searchable short labels used by the model registry UI.
  trainingMetadata       Json? /// Dataset version, row count, labels, and training provenance.
  evaluationMetadata     Json? /// Split strategy, cutoff, leakage audit, and evaluation configuration.
  metrics                Json? /// Offline validation metrics used when selecting the model.
  active                 Boolean  @default(false) /// Marks the model bundle used for new ranking runs.

  predictions     JobPrediction[] /// Prisma back-relation for results produced by this model version.
  processingRuns  ProcessingRun[] /// Ranking attempts pinned to this model version.
  deployment      ModelDeployment? /// Mutable remote serving configuration for this immutable model version.
  endpointChecks  ModelEndpointCheck[] /// Safe health-check history for this model version.
  invocations     ModelInvocation[] /// Every embedded or remote inference attempt using this bundle.
  activeForGroups Group[]              @relation("GroupActiveModel") /// Groups currently using this model for shared ranking.
  createdAt       DateTime             @default(now()) /// Orders model versions and supports rollback.

  // Finds the active production ranking model quickly.
  @@index([active])
}

/// Mutable network configuration used to invoke one immutable model version.
model ModelDeployment {
  id               String       @id @default(cuid()) /// Internal deployment identifier.
  modelVersionId   String       @unique /// Enforces at most one current deployment per model version.
  modelVersion     ModelVersion @relation(fields: [modelVersionId], references: [id], onDelete: Cascade) /// Loads immutable model metadata.
  kind             String       @default("EMBEDDED") /// EMBEDDED for bundled Vercel inference or REMOTE for an external worker.
  endpointUrl      String? /// HTTPS ranking endpoint for REMOTE deployments; null for embedded serving.
  healthUrl        String? /// Optional remote readiness endpoint; embedded checks call the local runtime.
  artifactLocation String? /// Bundle directory relative to the trusted backend model-bundle root.
  deployedRevision String? /// Source revision or deployment identifier used for audit and rollback.
  timeoutSeconds   Int          @default(120) /// Per-request timeout bounded below the hosting function limit.

  healthVerifiedAt    DateTime? /// Most recent compatible successful health response.
  lastHealthStatus    String? /// Safe READY or FAILED summary for list views.
  lastHealthLatencyMs Int? /// Round-trip time of the latest health check.
  lastHealthErrorCode String? /// Stable safe failure category; response bodies are never stored.

  checks    ModelEndpointCheck[] /// Historical probes made against this deployment.
  createdAt DateTime             @default(now()) /// Records when serving configuration was first supplied.
  updatedAt DateTime             @updatedAt /// Records URL, timeout, and health-summary changes.
}

/// One auditable health probe without credentials or response bodies.
model ModelEndpointCheck {
  id             String          @id @default(cuid()) /// Internal check identifier.
  modelVersionId String /// Identifies the immutable registry record checked.
  modelVersion   ModelVersion    @relation(fields: [modelVersionId], references: [id], onDelete: Cascade) /// Loads model metadata.
  deploymentId   String /// Identifies the deployment configuration checked.
  deployment     ModelDeployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade) /// Loads the current serving configuration.

  status                          String /// READY or FAILED safe result.
  latencyMs                       Int? /// Completed HTTP round-trip time.
  httpStatus                      Int? /// Provider HTTP status when a response was received.
  errorCode                       String? /// Stable network, contract, or status failure code.
  healthUrlSnapshot               String? /// Exact safe URL checked for remote deployments.
  returnedFeatureSchemaVersion    String? /// Feature contract reported by the remote service.
  returnedRequestContractVersion  String? /// Ranking request contract reported by the remote service.
  returnedResponseContractVersion String? /// Ranking response contract reported by the serving runtime.
  returnedArtifactHash            String? /// Immutable artifact hash reported by the serving runtime.
  coldStart                       Boolean? /// Whether this check loaded an uninitialized bundle.
  modelLoadMs                     Int? /// Time spent loading and validating artifacts.
  smokeTestMs                     Int? /// Time spent on the golden prediction.
  checkedAt                       DateTime @default(now()) /// Orders health history and gates activation.

  @@index([modelVersionId, checkedAt])
}

/// The usable outputs returned when one model version ranks one job.
model JobPrediction {
  id   String @id @default(cuid()) /// Internal identifier for this ranking result.
  rank Int /// Final position of the job within this batch.

  jediPreferenceScore        Float /// Primary 0-100 score used to order jobs.
  applyPreferenceProbability Float /// Apply-worthy classifier probability used as a guardrail.
  componentScores            Json? /// Optional Ridge fit-score outputs returned by the current model bundle.
  rankingScore               Float /// Explicit score used by the recorded ranking strategy.
  rankingStrategy            String /// Stable ordering policy such as apply-gate-then-jedi-v1.
  applyThreshold             Float? /// Classifier threshold used; null only for legacy predictions.
  modelApplyDecision         Boolean? /// Raw thresholded classifier decision.
  applyRecommendation        Boolean? /// Final model decision combined with listing availability.
  outputSchemaVersion        String   @default("legacy-ranking-v1") /// Version of this normalized prediction row.

  jobId String /// Identifies the ranked job.
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade) /// Loads the ranked job.

  batchId String /// Identifies the daily batch whose jobs were ranked together.
  batch   Batch  @relation(fields: [batchId], references: [id], onDelete: Cascade) /// Loads the ranking batch.

  profileVersionId String /// Identifies the resume and preferences used for this result.
  profileVersion   ProfileVersion @relation(fields: [profileVersionId], references: [id]) /// Loads that profile version.

  modelVersionId String /// Identifies the ranking bundle that returned this result.
  modelVersion   ModelVersion @relation(fields: [modelVersionId], references: [id]) /// Loads that model version.

  processingRunId String /// Identifies the exact ranking execution that produced this result.
  processingRun   ProcessingRun @relation(fields: [processingRunId], references: [id], onDelete: Cascade) /// Keeps reranking executions separate.

  createdAt DateTime @default(now()) /// Records when scoring completed.

  // Prevents the same model and profile from scoring one job twice in one batch.
  @@unique([jobId, processingRunId])
  // Retrieves a batch shortlist in display order.
  @@index([batchId, rank])
  @@index([processingRunId, rank])
}

/// The current user-controlled state of one job.
model JobState {
  groupMemberId  String /// Identifies the member who owns this private state.
  groupMember    GroupMember     @relation(fields: [groupMemberId], references: [id], onDelete: Cascade) /// Loads the state owner.
  jobId          String /// Identifies the shared job.
  job            Job             @relation(fields: [jobId], references: [id], onDelete: Cascade) /// Loads the associated job.
  relevanceLabel RelevanceLabel? /// Explicit Dream, Strong Apply, Consider, or Reject feedback.
  reviewStatus   ReviewStatus    @default(NEW) /// Tracks whether the job was viewed, saved, or dismissed.
  viewedAt       DateTime? /// First time this member deliberately viewed the job; null means fresh.
  notes          String? /// Private notes about reviewing the job before or alongside an application.
  updatedAt      DateTime        @updatedAt /// Records the latest state change.

  @@id([groupMemberId, jobId])
  @@index([jobId])
  @@index([groupMemberId, reviewStatus])
  @@index([groupMemberId, viewedAt])
}

/// The editable application plan and current main-funnel stage for one job.
model Application {
  id              String                 @id @default(cuid()) /// Stable identifier used by private events and milestones.
  groupMemberId   String /// Identifies the member pursuing this application.
  groupMember     GroupMember            @relation(fields: [groupMemberId], references: [id], onDelete: Cascade) /// Loads the application owner.
  jobId           String /// Identifies the shared job being pursued.
  job             Job                    @relation(fields: [jobId], references: [id], onDelete: Cascade) /// Loads the job being pursued.
  status          ApplicationStatus      @default(NOT_STARTED) /// Current user-controlled stage in the fixed funnel.
  appliedAt       DateTime? /// When the application was submitted; first APPLIED transition can populate it.
  targetApplyBy   DateTime? /// Optional personal deadline for submitting the application.
  nextAction      String? /// Concrete next step such as preparing an assessment.
  nextActionDueAt DateTime? /// Optional deadline for the concrete next action.
  portalUrl       String? /// Employer portal URL used to revisit the submitted application.
  referenceCode   String? /// Employer-provided application or reference identifier.
  notes           String? /// Notes specific to the application process.
  closedAt        DateTime? /// When the application entered a terminal outcome.
  milestones      ApplicationMilestone[] /// Flexible company-specific steps inside the fixed main funnel.
  events          ApplicationEvent[] /// Private status-transition history.
  createdAt       DateTime               @default(now()) /// When tracking first began for the job.
  updatedAt       DateTime               @updatedAt /// Optimistic-concurrency value for planning edits.

  @@unique([groupMemberId, jobId])
  @@index([jobId])
  @@index([groupMemberId, status, updatedAt])
  @@index([groupMemberId, nextActionDueAt])
}

/// One flexible screening, assessment, interview, follow-up, or custom step.
model ApplicationMilestone {
  id            String                     @id @default(cuid()) /// Internal identifier used for later edits.
  applicationId String /// Connects the milestone to its member-owned application.
  application   Application                @relation(fields: [applicationId], references: [id], onDelete: Cascade) /// Loads the private parent application.
  type          ApplicationMilestoneType /// Broad filterable category while title carries company-specific wording.
  title         String /// Human label such as Technical Round 2.
  status        ApplicationMilestoneStatus @default(PLANNED) /// Planned, completed, or cancelled without silent deletion.
  scheduledAt   DateTime? /// When the milestone is expected to happen.
  completedAt   DateTime? /// Set when completed and cleared when reopened.
  notes         String? /// Preparation notes or the result of this step.
  createdAt     DateTime                   @default(now()) /// When the milestone was recorded.
  updatedAt     DateTime                   @updatedAt /// When its schedule, status, or notes last changed.

  @@index([applicationId, scheduledAt])
}

/// One user-recorded application or response update for a job.
model ApplicationEvent {
  id             String             @id @default(cuid()) /// Internal identifier for the history entry.
  applicationId  String /// Identifies the member-owned application that changed.
  application    Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade) /// Loads the private application.
  eventType      String /// Stable key such as applied, assessment, interview, offer, or rejected.
  previousStatus ApplicationStatus? /// Main-funnel status before this event, when the event is a transition.
  newStatus      ApplicationStatus? /// Main-funnel status after this event, when the event is a transition.
  notes          String? /// Optional human context for this update.
  eventAt        DateTime           @default(now()) /// Date and time at which the update happened.
  createdAt      DateTime           @default(now()) /// Date and time at which the update was stored.

  // Retrieves one job's application history in chronological order.
  @@index([applicationId, eventAt])
}

/// One idempotent, retryable attempt to process a batch step.
model ProcessingRun {
  id                   String             @id @default(cuid()) /// Internal identifier for this processing attempt.
  batchId              String /// Identifies the batch being processed.
  batch                Batch              @relation(fields: [batchId], references: [id], onDelete: Cascade) /// Loads the owning batch.
  idempotencyKey       String             @unique /// Prevents one requested operation from running twice.
  status               ProcessingStatus   @default(QUEUED) /// Current worker lifecycle state.
  stage                String /// Step such as validation, deduplication, scoring, or email.
  phase                String             @default("QUEUED") /// Fine-grained user-visible progress within the stage.
  attempt              Int                @default(0) /// Retry number used by the worker.
  retryable            Boolean? /// Whether the recorded failure is safe to retry without changing inputs.
  trigger              String             @default("USER") /// USER, MANUAL_RETRY, AUTO_RETRY, or WORKER.
  retryOfRunId         String? /// Failed or stale run replaced by this run.
  retryOfRun           ProcessingRun?     @relation("ProcessingRunRetries", fields: [retryOfRunId], references: [id], onDelete: SetNull)
  retries              ProcessingRun[]    @relation("ProcessingRunRetries")
  profileVersionId     String? /// Pins normalization and ranking to one immutable profile.
  profileVersion       ProfileVersion?    @relation(fields: [profileVersionId], references: [id], onDelete: Restrict) /// Loads the pinned profile when the stage requires one.
  modelVersionId       String? /// Pins ranking to one immutable model registry entry.
  modelVersion         ModelVersion?      @relation(fields: [modelVersionId], references: [id], onDelete: Restrict) /// Loads the pinned model when the stage is ranking.
  featureSchemaVersion String? /// Pins the exact prepared-row contract consumed by the run.
  leaseToken           String? /// Secret worker ownership proof; never returned by user-facing endpoints.
  leaseExpiresAt       DateTime? /// Time after which another worker may reclaim an abandoned run.
  nextAttemptAt        DateTime? /// Earliest time at which an outbound dispatcher may retry the run.
  heartbeatAt          DateTime? /// Most recent proof that the owning worker is still alive.
  errorCode            String? /// Stable machine-readable failure category used by retry and support flows.
  errorMessage         String? /// Most recent failure detail needed for troubleshooting.
  startedAt            DateTime? /// Records when processing began.
  completedAt          DateTime? /// Records when processing reached success or failure.
  createdAt            DateTime           @default(now()) /// Records when the run was queued.
  predictions          JobPrediction[] /// Results produced by this exact ranking attempt.
  invocations          ModelInvocation[] /// Raw model attempts made while executing this run.
  emailDeliveries      EmailDelivery[] /// Legacy batch-specific digests retained during transition.
  emailCampaignRuns    EmailCampaignRun[] /// Daily campaigns whose top-ten selection used this successful run.

  // Supports batch-specific processing status views.
  @@index([batchId, status])
  @@index([retryOfRunId])
  // Finds claimable ranking work and expired leases without scanning run history.
  @@index([stage, status, nextAttemptAt, leaseExpiresAt, createdAt])
}

/// One auditable model call. Raw inputs remain in PreparedJob; only their hash is duplicated.
model ModelInvocation {
  id                      String        @id @default(cuid())
  processingRunId         String
  processingRun           ProcessingRun @relation(fields: [processingRunId], references: [id], onDelete: Cascade)
  modelVersionId          String
  modelVersion            ModelVersion  @relation(fields: [modelVersionId], references: [id], onDelete: Restrict)
  attempt                 Int
  status                  String
  requestContractVersion  String
  responseContractVersion String
  featureSchemaVersion    String
  artifactHash            String
  inputHash               String
  inputCount              Int
  outputCount             Int           @default(0)
  rawResponse             Json?
  coldStart               Boolean?
  timingsMs               Json?
  errorCode               String?
  errorMessage            String?
  startedAt               DateTime      @default(now())
  completedAt             DateTime?

  @@unique([processingRunId, attempt])
  @@index([modelVersionId, startedAt])
}

/// The owner-controlled newsletter settings. Application code always uses id "default".
model EmailConfiguration {
  id               String           @id @default("default") /// Fixed singleton key used for transactional recipient limits.
  enabled          Boolean          @default(false) /// Master switch for automatic and manual newsletter sending.
  senderName       String           @default("JEDI Daily Dispatch") /// Display name used in From headers.
  sendAfterRanking Boolean          @default(true) /// Allows immediate sending after the daily cutoff.
  recipients       EmailRecipient[] /// Addresses governed by the 50-active-recipient limit.
  createdAt        DateTime         @default(now()) /// Records initial configuration creation.
  updatedAt        DateTime         @updatedAt /// Records owner changes to newsletter behavior.
}

/// One configurable newsletter recipient; deletion is soft to preserve history.
model EmailRecipient {
  id              String             @id @default(cuid()) /// Internal identifier used by delivery history.
  configurationId String             @default("default") /// Links recipient mutations to the lockable singleton row.
  configuration   EmailConfiguration @relation(fields: [configurationId], references: [id], onDelete: Restrict) /// Loads newsletter settings.
  email           String /// Current display form of the destination address.
  emailNormalized String             @unique /// Lowercase canonical key used for replay and uniqueness.
  displayName     String? /// Optional friendly recipient name.
  groupMemberId   String?            @unique /// Links onboarded recipients to the member profile used for personalization; null only for preserved legacy rows.
  groupMember     GroupMember?       @relation(fields: [groupMemberId], references: [id], onDelete: SetNull) /// Loads the member and their current onboarding profile.
  active          Boolean            @default(true) /// Controls inclusion in future campaigns.
  deletedAt       DateTime? /// Soft-deletion marker; historical deliveries remain intact.
  deliveries      EmailDelivery[] /// Per-campaign delivery records for this recipient.
  createdAt       DateTime           @default(now()) /// Records first addition to the list.
  updatedAt       DateTime           @updatedAt /// Records edits, disablement, or reactivation.

  @@index([active, deletedAt])
}

/// One dated top-ten newsletter and its immutable send-time snapshot.
model EmailCampaign {
  id               String              @id @default(cuid()) /// Internal identifier used by history and retries.
  campaignDate     DateTime            @db.Date /// Asia/Kolkata calendar date represented by the newsletter.
  digestType       String              @default("DAILY_TOP_10") /// Allows future digest formats without mixing history.
  status           EmailCampaignStatus @default(WAITING_FOR_RANKINGS) /// Aggregate delivery state.
  scheduledAt      DateTime /// UTC instant corresponding to the day's 09:00 IST delivery window.
  templateVersion  String              @default("daily-top-10-v1") /// Rendering contract used for the stored body.
  payloadSnapshot  Json? /// Exact subject, HTML, text, and selected job provenance.
  selectedJobCount Int                 @default(0) /// Number of ranked jobs captured, up to ten.
  recipientCount   Int                 @default(0) /// Recipient snapshot size when deliveries were queued.
  sentCount        Int                 @default(0) /// Provider-accepted delivery count.
  failedCount      Int                 @default(0) /// Failed delivery count for the current campaign state.
  cancelledCount   Int                 @default(0) /// Deliveries cancelled before SMTP because a recipient was disabled.
  failureReason    String? /// Stable aggregate reason such as NO_RANKINGS or EMAIL_DISABLED.
  lastReconciledAt DateTime? /// Most recent cron or manual audit pass.
  queuedAt         DateTime? /// Time recipient delivery rows were created.
  sentAt           DateTime? /// Time all eligible recipients reached SENT.
  completedAt      DateTime? /// Time the campaign reached a terminal aggregate state.
  runs             EmailCampaignRun[] /// Successful ranking runs used by the top-ten snapshot.
  deliveries       EmailDelivery[] /// Independent recipient sends for this campaign.
  createdAt        DateTime            @default(now()) /// Records first campaign creation.
  updatedAt        DateTime            @updatedAt /// Records snapshot and aggregate status changes.

  @@unique([campaignDate, digestType])
  @@index([status, scheduledAt])
}

/// Join table preserving every ranking run used to construct a campaign.
model EmailCampaignRun {
  campaignId      String /// Identifies the dated campaign.
  campaign        EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade) /// Loads campaign history.
  processingRunId String /// Identifies one successful ranking execution used by the campaign.
  processingRun   ProcessingRun @relation(fields: [processingRunId], references: [id], onDelete: Restrict) /// Loads immutable ranking provenance.
  addedAt         DateTime      @default(now()) /// Records when reconciliation selected the run.

  @@id([campaignId, processingRunId])
  @@index([processingRunId])
}

/// One independently retryable recipient send within a daily campaign.
model EmailDelivery {
  id                   String                 @id @default(cuid()) /// Internal identifier for this delivery record.
  campaignId           String? /// Identifies the daily newsletter; nullable only for legacy batch delivery compatibility.
  campaign             EmailCampaign?         @relation(fields: [campaignId], references: [id], onDelete: Cascade) /// Loads aggregate campaign state.
  recipientId          String? /// Identifies the configured recipient; nullable only for legacy deliveries.
  recipientRecord      EmailRecipient?        @relation(fields: [recipientId], references: [id], onDelete: Restrict) /// Loads current recipient configuration.
  recipient            String /// Send-time destination snapshot retained after edits or deletion.
  recipientDisplayName String? /// Send-time friendly-name snapshot.
  groupMemberId        String? /// Identifies the member whose profile personalizes this event; nullable only for preserved legacy rows.
  groupMember          GroupMember?           @relation(fields: [groupMemberId], references: [id], onDelete: Restrict) /// Loads the personalized event owner.
  batchId              String? /// Legacy batch provenance retained for compatibility routes.
  batch                Batch?                 @relation(fields: [batchId], references: [id], onDelete: Cascade) /// Loads legacy summarized batch when present.
  rankingRunId         String? /// Legacy single-run provenance; campaigns use EmailCampaignRun instead.
  rankingRun           ProcessingRun?         @relation(fields: [rankingRunId], references: [id], onDelete: Restrict) /// Loads legacy ranking provenance when present.
  templateVersion      String /// Identifies the HTML and text rendering contract.
  messageId            String                 @unique /// Stable RFC Message-ID reused across retries.
  status               EmailStatus            @default(UNTOUCHED) /// Current provider-delivery state.
  attempts             Int                    @default(0) /// Total send attempts across every manual retry cycle.
  retryCycle           Int                    @default(0) /// Increments when the owner explicitly restarts failed delivery.
  retryCycleAttempts   Int                    @default(0) /// Automatic attempts consumed in the current cycle.
  providerMessageId    String? /// Provider identifier used to trace a successful send.
  payloadSnapshot      Json? /// Exact subject and body; null until an untouched event is first rendered.
  profileContentHash   String? /// Pins the member-profile content used to produce the stored payload.
  personalizedJobs     Json? /// Immutable ordered top-ten job and score snapshot used by the email.
  lastError            String? /// Most recent provider or transport error.
  errorCode            String? /// Stable machine-readable delivery failure category.
  leaseToken           String? /// Secret proof owned by the sender currently attempting delivery.
  leaseExpiresAt       DateTime? /// Allows a later invocation to reclaim an abandoned send.
  nextAttemptAt        DateTime? /// Earliest time at which the cron may retry this delivery.
  sentAt               DateTime? /// Records when the provider accepted the email.
  createdAt            DateTime               @default(now()) /// Records when delivery was first queued.
  updatedAt            DateTime               @updatedAt /// Records snapshot, retry, and delivery state changes.
  attemptHistory       EmailDeliveryAttempt[] /// Immutable provider-attempt and manual-action audit history.

  // Ensures one configured address is represented once in a daily campaign.
  @@unique([campaignId, recipientId])
  // Makes event creation idempotent for one recipient and one exact ranking run.
  @@unique([batchId, rankingRunId, recipientId])
  // Ensures every group member receives one auditable event for an exact ranking.
  @@unique([batchId, rankingRunId, groupMemberId])
  @@index([status, nextAttemptAt, createdAt])
  @@index([campaignId, status])
  @@index([createdAt, id])
  @@index([batchId, createdAt])
  @@index([recipientId, createdAt])
  @@index([groupMemberId, createdAt])
}

/// One immutable delivery attempt or owner-triggered send action for an email event.
model EmailDeliveryAttempt {
  id                       String        @id @default(cuid())
  emailDeliveryId          String
  emailDelivery            EmailDelivery @relation(fields: [emailDeliveryId], references: [id], onDelete: Cascade)
  attemptNumber            Int
  retryCycle               Int
  trigger                  String /// CRON or MANUAL.
  status                   String /// SENDING, SENT, FAILED, or SKIPPED.
  requestedByGroupMemberId String?
  requestedBy              GroupMember?  @relation("EmailDeliveryAttemptActor", fields: [requestedByGroupMemberId], references: [id], onDelete: SetNull)
  startedAt                DateTime      @default(now())
  completedAt              DateTime?
  providerMessageId        String?
  errorCode                String?
  safeErrorMessage         String?

  @@unique([emailDeliveryId, retryCycle, attemptNumber])
  @@index([emailDeliveryId, startedAt])
  @@index([requestedByGroupMemberId, startedAt])
}


/// Reviewed personal resume facts; never the shared model profile.
model ResumeEvidence {
  id String @id @default(cuid())
  groupMemberId String @unique
  groupMember GroupMember @relation(fields: [groupMemberId], references: [id], onDelete: Cascade)
  evidence Json
  updatedAt DateTime @updatedAt
}

/// Private timed sprint, with versioned content and immutable submitted answers.
model LearningAttempt {
  id String @id @default(cuid())
  groupMemberId String
  groupMember GroupMember @relation(fields: [groupMemberId], references: [id], onDelete: Cascade)
  topicId String
  jobId String?
  snapshot Json
  answers Json
  status String @default("ACTIVE")
  revision Int @default(0)
  startedAt DateTime @default(now())
  deadlineAt DateTime
  finishedAt DateTime?

  @@index([groupMemberId, startedAt])
}
