{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "nextjs"
    },
    "backend": {
      "root": "backend/",
      "framework": "fastapi",
      "entrypoint": "main:app",
      "functions": {
        "main.py": {
          "excludeFiles": "{tests/**,**/__pycache__/**,**/.pytest_cache/**,**/.ruff_cache/**,**/*.pyc}",
          "includeFiles": "model_bundles/**",
          "maxDuration": 300,
          "memory": 2048
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/svc/ml/:path*",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ],
  "crons": [
    {
      "path": "/svc/ml/internal/email-deliveries/run",
      "schedule": "30 18 * * *"
    }
  ]
}
