# Pooled Neon connection used by FastAPI at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Direct Neon connection used by Prisma migrations.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

APP_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
BACKEND_URL="http://localhost:8000"
CORS_ORIGINS="http://localhost:3000"

ML_SERVICE_SECRET="replace-with-a-different-32-character-secret"
MODEL_BUNDLE_ROOT="model_bundles"
MODEL_LOAD_TIMEOUT_SECONDS="30"
MODEL_EXECUTION_TIMEOUT_SECONDS="240"
MODEL_MAX_BATCH_SIZE="500"

# FastAPI signs the private login cookie with this value.
SESSION_SECRET="replace-with-at-least-32-random-characters"
SESSION_COOKIE_SECURE="false"

GMAIL_SMTP_USER=""
GMAIL_SMTP_APP_PASSWORD=""
EMAIL_FROM_NAME="JEDI Job Digest"
CRON_SECRET="replace-with-a-third-independent-32-character-secret"
