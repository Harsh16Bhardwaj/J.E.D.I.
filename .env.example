# Pooled Neon connection used by Next.js at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Direct Neon connection used by Prisma migrations.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
BACKEND_URL="http://localhost:8000"
CORS_ORIGINS="http://localhost:3000"

ML_SERVICE_SECRET="replace-me"
JEDI_PASSWORD_HASH="replace-me"
SESSION_SECRET="replace-me"

GMAIL_SMTP_USER=""
GMAIL_SMTP_APP_PASSWORD=""
DIGEST_TO_EMAIL=""
