{
  "name": "jedi",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.1.0",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names WEB,API --prefix-colors green,magenta \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm run dev --workspace=frontend",
    "dev:api": "backend\\.venv\\Scripts\\python.exe -m uvicorn backend.main:app --reload --port 8000",
    "start:web": "npm run start --workspace=frontend",
    "setup:api": "python -m venv backend/.venv && backend\\.venv\\Scripts\\python.exe -m pip install -e \"backend[dev]\"",
    "build": "npm run build --workspace=frontend",
    "lint": "npm run lint --workspace=frontend",
    "lint:api": "backend\\.venv\\Scripts\\python.exe -m ruff check backend",
    "typecheck": "npm run typecheck --workspace=frontend",
    "test": "npm run test:api",
    "test:api": "backend\\.venv\\Scripts\\python.exe -m pytest backend/tests",
    "user:bootstrap": "backend\\.venv\\Scripts\\python.exe -m backend.commands.bootstrap_user",
    "model:export": "backend\\.venv\\Scripts\\python.exe ML/tools/export_production_bundle.py",
    "model:smoke": "backend\\.venv\\Scripts\\python.exe -m backend.commands.model_ops smoke",
    "model:benchmark": "backend\\.venv\\Scripts\\python.exe -m backend.commands.model_ops benchmark",
    "check": "npm run db:validate && npm run lint && npm run typecheck && npm run test:api && npm run lint:api && npm run build",
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "devDependencies": {
    "concurrently": "10.0.4",
    "dotenv": "17.4.2",
    "prisma": "7.9.1",
    "tsx": "4.23.1"
  }
}
